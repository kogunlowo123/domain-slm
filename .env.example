# Copy to .env and edit. `.env` is gitignored, and CI runs a secret scan over
# the working tree and the full git history on every push.
#
# Very little belongs here. What a run decides — the thresholds, the tolerance,
# the vocabulary, the seed — is also available on the command line, where it is
# visible in a diff. A setting that changes a verdict from an environment
# variable is a setting that changes a verdict invisibly, so these are the values
# a machine falls back to rather than the place to configure a result.
#
# Variables are DSLM_<SECTION>__<FIELD>. There are exactly three sections: gate,
# log, train. Every section forbids unknown keys, and a misspelt section name is
# refused too — pydantic never builds a `gates` key for `extra="forbid"` to
# reject, so `load()` checks the section names itself. A typo here is an error
# with a remedy, not a line that is silently ignored.

# -- the gates -----------------------------------------------------------

# How far a metric may fall against the committed baseline before the
# regression gate fails. Half a point.
#
# This is not absorbing floating-point noise: the metrics are bit-identical
# across platforms at this scale. It absorbs the genuine run-to-run variation a
# different NumPy resolving a different BLAS produces. See
# docs/reproducibility.md for the measurement.
DSLM_GATE__TOLERANCE=0.005

# The share of an evaluation set that may be contaminated before the gate fails.
#
# Not zero, on purpose: one duplicated record in a thousand does not invalidate
# a measurement, and a gate that fails on it is a gate someone will disable.
DSLM_GATE__MAX_CONTAMINATED=0.02

# The share of an evaluation set that must be long enough to check at all.
#
# A 13-gram check over eight-word records examines almost nothing and reports
# zero contamination, which reads exactly like a clean result. Below this the
# gate refuses rather than passing: a check that did not apply has not passed.
DSLM_GATE__MIN_COVERAGE=0.5

# The quantile of the null distribution used as the contamination threshold.
#
# A quantile is a promise about how often provably disjoint data will be called
# contaminated. At 0.99 that is one record in a hundred, which is a floor under
# every measurement the gate makes. See docs/contamination.md.
DSLM_GATE__QUANTILE=0.999

# -- training ------------------------------------------------------------

# Tokens the byte-pair encoder learns. Bigger is not better here; the sweep is
# in docs/tokenizer.md.
DSLM_TRAIN__VOCAB_SIZE=1024

# Tokens kept per record. Records longer than this are truncated, and the count
# of truncated records is reported rather than hidden.
DSLM_TRAIN__MAX_TOKENS=64

# Passes over the training set, with early stopping on the dev split. Letting a
# run continue past its dev peak costs accuracy rather than gaining it, because
# the spare capacity goes into memorising the corpus's label noise.
DSLM_TRAIN__EPOCHS=20

# Recorded in every artefact this produces, so a run can be repeated exactly on
# the same platform and to within tolerance on another.
DSLM_TRAIN__SEED=20260908

# -- diagnostics ---------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
DSLM_LOG__LEVEL=INFO

# json for CI, console for a terminal. Logs always go to stderr — stdout carries
# the report, and a log line in the middle of a JSON document is a broken build
# with a confusing cause.
DSLM_LOG__FORMAT=console

# -- what is deliberately not here ---------------------------------------
#
# There is no credential of any kind, and no endpoint. This project reads files
# and writes reports; it has no HTTP client and no socket anywhere in the
# package, and a test asserts that over the source. If you were looking for a
# place to put an API key, there isn't one, and that is the intended answer.
